# Copy to .env in the repository root and fill in. Never commit .env.

# The address players type. Its DNS A record must point at this server.
SOLAR_DOMAIN=play.lunarark.com

# Invitation code needed to found a company. Leave empty to let anyone in.
# The development fund that stakes new companies is finite, so keep this set
# until real accounts (one per person, invariant 8) exist.
SOLAR_ACCESS_CODE=change-me

# Game hours a brand-new world runs before it opens, so it has prices and a
# history on day one. Only used the very first time the world is created.
SOLAR_WARMUP_TICKS=168
